<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-5xl space-y-8 px-4 py-8">
    <section class="flex flex-col gap-5">
      <div class="min-w-0 space-y-3">
        <div class="space-y-2">
          <p class="text-sm font-medium uppercase tracking-[0.16em] app-muted">
            Deck
          </p>

          <div class="flex items-end gap-3">
            <.link
              navigate={~p"/decks"}
              class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-900/15 bg-slate-900/8 text-slate-700 transition hover:border-slate-900/25 hover:bg-slate-900/12 hover:text-slate-900"
              aria-label="Back to decks"
            >
              <.icon name="hero-chevron-left" class="h-5 w-5" />
            </.link>

            <div class="flex min-w-0 items-end gap-1">
              <h1 class="truncate text-3xl font-semibold tracking-tight">
                {@deck.name}
              </h1>

              <.link
                patch={~p"/decks/#{@deck}/show/edit"}
                class="mb-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-slate-600 transition hover:bg-slate-900/8 hover:text-slate-900"
                aria-label="Edit deck"
              >
                <.icon name="hero-pencil-square" class="h-4 w-4" />
              </.link>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 pl-13 text-sm">
            <span class="app-badge">{@deck.format}</span>
            <span class="app-badge capitalize">{@deck.visibility}</span>
            <span class="app-muted">
              {Enum.reduce(@deck.deck_entries, 0, fn entry, acc -> entry.quantity + acc end)} cards
            </span>
          </div>
        </div>

        <%= if @deck.description not in [nil, ""] do %>
          <p class="max-w-2xl text-sm app-muted">
            {@deck.description}
          </p>
        <% end %>
      </div>
    </section>

    <section class="grid gap-5 lg:grid-cols-2">
      <div class="app-panel space-y-4 p-5">
        <div class="space-y-1">
          <h2 class="text-xl font-medium">Add cards</h2>
          <p class="text-sm app-muted">
            Search the catalog and add cards directly to this deck.
          </p>
        </div>

        <div id="add-card-picker" class="space-y-3">
          <div class="relative">
            <label for="card-search-input" class="mb-1 block text-sm font-medium">
              Search cards
            </label>

            <input
              id="card-search-input"
              name="card_search"
              type="text"
              value={@search_term}
              phx-keyup="search_cards"
              placeholder="Try: Sol Ring, Brushland, Opt..."
              autocomplete="off"
              class="app-input w-full"
            />

            <div
              :if={@search_results != []}
              id="card-search-results"
              class="absolute z-20 mt-2 max-h-56 w-full overflow-y-auto rounded-lg border border-[var(--border)] bg-white shadow-lg"
            >
              <button
                :for={card <- @search_results}
                id={"card-search-option-#{card.id}"}
                type="button"
                phx-click="select_card"
                phx-value-id={card.id}
                class="block w-full px-3 py-2 text-left text-sm transition hover:bg-zinc-100"
              >
                {card.name}
              </button>
            </div>
          </div>
        </div>

        <div
          :if={@search_term != "" and @search_results == []}
          class="app-panel border-dashed p-4 text-sm app-muted"
        >
          No cards found.
        </div>
      </div>

      <div class="app-panel flex h-full flex-col justify-between gap-6 p-5">
        <div class="space-y-1">
          <h2 class="text-xl font-medium">Search deck</h2>
          <p class="text-sm app-muted">
            Search only cards already in this deck with your advanced deck query syntax.
          </p>
        </div>

        <.form
          for={%{}}
          as={:search}
          id="deck-search-form"
          phx-change="search_deck"
          class="space-y-3"
        >
          <label for="deck-search-query" class="block text-sm font-medium">
            Search this deck
          </label>

          <div class="flex items-center gap-3">
            <div class="min-w-0 flex-1">
              <.input
                id="deck-search-query"
                name="search[q]"
                type="text"
                value={@deck_query}
                placeholder="Try: draw, creature, land, counterspell..."
                autocomplete="off"
                phx-debounce="300"
                class="app-input"
              />
            </div>

            <button
              :if={@deck_query != ""}
              type="button"
              phx-click="clear_deck_search"
              class="app-button-secondary shrink-0"
            >
              Reset
            </button>
          </div>
        </.form>

        <%= if @deck_search_error do %>
          <div class="text-sm text-red-700">
            {@deck_search_error}
          </div>
        <% end %>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="space-y-1">
          <h2 class="text-2xl font-semibold tracking-tight">Decklist</h2>
          <p class="text-sm app-muted">Cards currently in this deck.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            id="open-deck-importer"
            type="button"
            phx-click="open_deck_importer"
            class="app-button-secondary inline-flex items-center gap-2"
          >
            <.icon name="hero-arrow-up-tray" class="h-4 w-4" /> Import Decklist
          </button>

          <div class="text-sm app-muted">
            <%= if @deck_query != "" and is_nil(@deck_search_error) do %>
              {@deck_search_match_count} matches
            <% else %>
              {Enum.reduce(@deck.deck_entries, 0, fn entry, acc -> entry.quantity + acc end)} cards
            <% end %>
          </div>

          <button
            id="deck-sort-type-toggle"
            type="button"
            phx-click="toggle_type_sort"
            aria-pressed={@sort_by_type?}
            class={[
              "inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-sm font-medium shadow-sm transition",
              @sort_by_type? && "border-slate-900/30 bg-[var(--brand)] text-[var(--text)]",
              !@sort_by_type? && "border-slate-900/10 bg-white text-zinc-600 hover:bg-zinc-100"
            ]}
          >
            <span class={[
              "relative h-4 w-7 rounded-full transition",
              @sort_by_type? && "bg-slate-900/75",
              !@sort_by_type? && "bg-slate-300"
            ]}>
              <span class={[
                "absolute top-0.5 h-3 w-3 rounded-full bg-white transition",
                @sort_by_type? && "left-3.5",
                !@sort_by_type? && "left-0.5"
              ]}>
              </span>
            </span>
            Sort by type
          </button>

          <div class="inline-flex rounded-lg border bg-white p-1 shadow-sm">
            <button
              phx-click="set_view_mode"
              phx-value-mode="details"
              class={[
                "rounded-md px-3 py-1.5 text-sm font-medium transition",
                @view_mode == "details" && "bg-[var(--brand)] text-[var(--text)]",
                @view_mode != "details" && "text-zinc-600 hover:bg-zinc-100"
              ]}
            >
              Details
            </button>

            <button
              phx-click="set_view_mode"
              phx-value-mode="images"
              class={[
                "rounded-md px-3 py-1.5 text-sm font-medium transition",
                @view_mode == "images" && "bg-[var(--brand)] text-[var(--text)]",
                @view_mode != "images" && "text-zinc-600 hover:bg-zinc-100"
              ]}
            >
              Images
            </button>

            <button
              phx-click="set_view_mode"
              phx-value-mode="list"
              class={[
                "rounded-md px-3 py-1.5 text-sm font-medium transition",
                @view_mode == "list" && "bg-[var(--brand)] text-[var(--text)]",
                @view_mode != "list" && "text-zinc-600 hover:bg-zinc-100"
              ]}
            >
              List
            </button>
          </div>
        </div>
      </div>

      <%= if map_size(@visible_entries_by_section) == 0 do %>
        <div class="app-panel border-dashed p-8 text-center">
          <div class="mx-auto max-w-md space-y-2">
            <%= cond do %>
              <% @deck_query != "" and is_nil(@deck_search_error) -> %>
                <h3 class="text-lg font-medium">No matching cards</h3>
                <p class="text-sm app-muted">
                  Try adjusting the deck search query to broaden the results.
                </p>
              <% @deck_query != "" -> %>
                <h3 class="text-lg font-medium">Search query needs attention</h3>
                <p class="text-sm app-muted">
                  Fix the query in the search card to continue filtering this decklist.
                </p>
              <% true -> %>
                <h3 class="text-lg font-medium">This deck is empty</h3>
                <p class="text-sm app-muted">
                  Search above to add some cards and start building it out.
                </p>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= if @view_mode == "list" do %>
        <div class="grid gap-6 lg:grid-cols-[280px_minmax(0,1fr)] xl:grid-cols-[320px_minmax(0,1fr)]">
          <aside class="hidden lg:block">
            <div class="sticky top-24 space-y-3">
              <div class="app-panel overflow-hidden p-3">
                <%= if @preview_card do %>
                  <%= if image = @preview_card.image_uris["normal"] do %>
                    <img
                      src={image}
                      alt={@preview_card.name}
                      class="w-full rounded-xl"
                    />
                  <% else %>
                    <div class="flex aspect-[5/7] items-center justify-center rounded-xl bg-zinc-100 text-sm app-muted">
                      No image
                    </div>
                  <% end %>
                <% end %>
              </div>

              <%= if @preview_card do %>
                <div class="app-panel p-4">
                  <div class="space-y-1">
                    <div class="font-semibold">{@preview_card.name}</div>

                    <%= if @preview_card.mana_cost not in [nil, ""] do %>
                      <div class="text-sm app-muted">
                        <.mana_text text={@preview_card.mana_cost} mode="cost" />
                      </div>
                    <% end %>

                    <div class="text-sm app-muted">{@preview_card.type_line}</div>
                  </div>

                  <%= if @preview_card.oracle_text not in [nil, ""] do %>
                    <div class="mt-3 text-sm app-muted">
                      <.mana_text text={@preview_card.oracle_text} />
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </aside>

          <div id="deck-list-columns" class="grid gap-5 xl:grid-cols-2">
            <div
              :for={
                {rows, column_index} <-
                  Enum.with_index(
                    list_view_columns(@visible_entries_by_section, @sort_by_type?),
                    1
                  )
              }
              id={"deck-list-column-#{column_index}"}
              class="app-panel overflow-hidden"
            >
              <%= for row <- rows do %>
                <%= case row do %>
                  <% {:section, section, card_count} -> %>
                    <div
                      id={"deck-section-heading-#{section}"}
                      class="flex items-center justify-between border-b px-5 py-4"
                    >
                      <div class="space-y-1">
                        <h3 class="text-xl font-medium capitalize">{section}</h3>
                        <p class="text-sm app-muted">{card_count} cards</p>
                      </div>
                    </div>
                  <% {:type_group, section, group, card_count} -> %>
                    <h4
                      id={type_group_id(section, group)}
                      class="flex items-center justify-between gap-3 border-b bg-black/5 px-5 py-3 text-sm font-semibold uppercase tracking-[0.14em] app-muted"
                    >
                      <span>{group}</span>
                      <span class="shrink-0 text-xs normal-case tracking-normal">
                        {card_count_label(card_count)}
                      </span>
                    </h4>
                  <% {:entry, entry} -> %>
                    <article
                      class={[
                        "flex items-center justify-between gap-4 border-b bg-white px-5 py-3 transition last:border-b-0 hover:bg-black/5",
                        @preview_card && @preview_card.id == entry.card.id && "bg-black/5"
                      ]}
                      id={"deck-entry-#{entry.id}"}
                      phx-hook="CardPreview"
                      data-card-id={entry.card.id}
                      phx-value-card_id={entry.card.id}
                    >
                      <div class="min-w-0 flex items-center gap-3">
                        <span class="w-8 shrink-0 text-left text-sm font-medium app-muted">
                          {entry.quantity}
                        </span>

                        <.link
                          navigate={~p"/cards/#{entry.card}"}
                          class="truncate text-left font-medium hover:underline"
                        >
                          {entry.card.name}
                        </.link>
                      </div>

                      <div class="shrink-0 text-right text-sm app-muted">
                        <%= if entry.card.mana_cost not in [nil, ""] do %>
                          <.mana_text text={entry.card.mana_cost} mode="cost" />
                        <% end %>
                      </div>
                    </article>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="space-y-5">
          <%= for {section, entries} <- @visible_entries_by_section do %>
            <section id={"deck-section-#{section}"} class="app-panel overflow-hidden">
              <div class="flex items-center justify-between border-b px-5 py-4">
                <div class="space-y-1">
                  <h3 class="text-xl font-medium capitalize">{section}</h3>
                  <p class="text-sm app-muted">
                    {Enum.reduce(entries, 0, fn entry, acc -> entry.quantity + acc end)} cards
                  </p>
                </div>
              </div>

              <%= if @view_mode == "details" do %>
                <%= if @sort_by_type? do %>
                  <div class="divide-y">
                    <div
                      :for={{group, group_entries} <- grouped_entries(entries)}
                      id={type_group_id(section, group)}
                    >
                      <h4 class="flex items-center justify-between gap-3 bg-black/5 px-5 py-3 text-sm font-semibold uppercase tracking-[0.14em] app-muted">
                        <span>{group}</span>
                        <span class="shrink-0 text-xs normal-case tracking-normal">
                          {card_count_label(entry_count(group_entries))}
                        </span>
                      </h4>

                      <div class="divide-y">
                        <%= for entry <- group_entries do %>
                          <article id={"deck-entry-#{entry.id}"} class="px-5 py-4">
                            <div class="flex items-start justify-between gap-4">
                              <div class="min-w-0 space-y-1">
                                <div class="text-lg font-medium">
                                  {entry.quantity} ×
                                  <.link
                                    navigate={~p"/cards/#{entry.card}"}
                                    class="hover:underline"
                                  >
                                    {entry.card.name}
                                  </.link>
                                </div>

                                <div class="text-sm app-muted">
                                  {entry.card.type_line}
                                </div>

                                <%= if entry.card.oracle_text not in [nil, ""] do %>
                                  <div class="mt-2 text-sm app-muted">
                                    <.mana_text text={entry.card.oracle_text} />
                                  </div>
                                <% end %>
                              </div>

                              <div class="flex shrink-0 items-center gap-4 pt-1">
                                <div class="text-sm app-muted">
                                  <%= if entry.card.mana_cost not in [nil, ""] do %>
                                    <.mana_text text={entry.card.mana_cost} mode="cost" />
                                  <% end %>
                                </div>

                                <button
                                  phx-click="remove_entry"
                                  phx-value-id={entry.id}
                                  data-confirm="Remove this card from the deck?"
                                  class="app-link-danger"
                                >
                                  Remove
                                </button>
                              </div>
                            </div>
                          </article>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="divide-y">
                    <%= for entry <- entries do %>
                      <article id={"deck-entry-#{entry.id}"} class="px-5 py-4">
                        <div class="flex items-start justify-between gap-4">
                          <div class="min-w-0 space-y-1">
                            <div class="text-lg font-medium">
                              {entry.quantity} ×
                              <.link navigate={~p"/cards/#{entry.card}"} class="hover:underline">
                                {entry.card.name}
                              </.link>
                            </div>

                            <div class="text-sm app-muted">
                              {entry.card.type_line}
                            </div>

                            <%= if entry.card.oracle_text not in [nil, ""] do %>
                              <div class="mt-2 text-sm app-muted">
                                <.mana_text text={entry.card.oracle_text} />
                              </div>
                            <% end %>
                          </div>

                          <div class="flex shrink-0 items-center gap-4 pt-1">
                            <div class="text-sm app-muted">
                              <%= if entry.card.mana_cost not in [nil, ""] do %>
                                <.mana_text text={entry.card.mana_cost} mode="cost" />
                              <% end %>
                            </div>

                            <button
                              phx-click="remove_entry"
                              phx-value-id={entry.id}
                              data-confirm="Remove this card from the deck?"
                              class="app-link-danger"
                            >
                              Remove
                            </button>
                          </div>
                        </div>
                      </article>
                    <% end %>
                  </div>
                <% end %>
              <% end %>

              <%= if @view_mode == "images" do %>
                <%= if @sort_by_type? do %>
                  <div class="divide-y">
                    <div
                      :for={{group, group_entries} <- grouped_entries(entries)}
                      id={type_group_id(section, group)}
                    >
                      <h4 class="flex items-center justify-between gap-3 bg-black/5 px-5 py-3 text-sm font-semibold uppercase tracking-[0.14em] app-muted">
                        <span>{group}</span>
                        <span class="shrink-0 text-xs normal-case tracking-normal">
                          {card_count_label(entry_count(group_entries))}
                        </span>
                      </h4>

                      <div class="grid grid-cols-2 gap-4 p-5 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                        <%= for entry <- group_entries do %>
                          <article id={"deck-entry-#{entry.id}"} class="space-y-2">
                            <.link
                              navigate={~p"/cards/#{entry.card}"}
                              class="relative block overflow-hidden rounded-xl border bg-white shadow-sm transition hover:-translate-y-[1px] hover:shadow-md"
                            >
                              <%= if image = entry.card.image_uris["normal"] do %>
                                <img
                                  src={image}
                                  alt={entry.card.name}
                                  class="w-full"
                                />
                              <% else %>
                                <div class="flex aspect-[5/7] items-center justify-center bg-zinc-100 text-sm app-muted">
                                  No image
                                </div>
                              <% end %>

                              <div class="absolute left-2 top-2 rounded-full bg-black/75 px-2 py-1 text-xs font-semibold text-white">
                                ×{entry.quantity}
                              </div>
                            </.link>

                            <div class="flex items-start justify-between gap-2">
                              <.link
                                navigate={~p"/cards/#{entry.card}"}
                                class="min-w-0 text-sm font-medium hover:underline"
                              >
                                {entry.card.name}
                              </.link>

                              <button
                                phx-click="remove_entry"
                                phx-value-id={entry.id}
                                data-confirm="Remove this card from the deck?"
                                class="shrink-0 text-xs app-link-danger"
                              >
                                Remove
                              </button>
                            </div>
                          </article>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="grid grid-cols-2 gap-4 p-5 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                    <%= for entry <- entries do %>
                      <article id={"deck-entry-#{entry.id}"} class="space-y-2">
                        <.link
                          navigate={~p"/cards/#{entry.card}"}
                          class="relative block overflow-hidden rounded-xl border bg-white shadow-sm transition hover:-translate-y-[1px] hover:shadow-md"
                        >
                          <%= if image = entry.card.image_uris["normal"] do %>
                            <img
                              src={image}
                              alt={entry.card.name}
                              class="w-full"
                            />
                          <% else %>
                            <div class="flex aspect-[5/7] items-center justify-center bg-zinc-100 text-sm app-muted">
                              No image
                            </div>
                          <% end %>

                          <div class="absolute left-2 top-2 rounded-full bg-black/75 px-2 py-1 text-xs font-semibold text-white">
                            ×{entry.quantity}
                          </div>
                        </.link>

                        <div class="flex items-start justify-between gap-2">
                          <.link
                            navigate={~p"/cards/#{entry.card}"}
                            class="min-w-0 text-sm font-medium hover:underline"
                          >
                            {entry.card.name}
                          </.link>

                          <button
                            phx-click="remove_entry"
                            phx-value-id={entry.id}
                            data-confirm="Remove this card from the deck?"
                            class="shrink-0 text-xs app-link-danger"
                          >
                            Remove
                          </button>
                        </div>
                      </article>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </section>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>

  <div
    :if={@live_action == :edit}
    id="deck-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4"
  >
    <.link
      patch={~p"/decks/#{@deck}"}
      class="absolute inset-0 bg-zinc-950/60 backdrop-blur-sm"
      aria-label="Close modal"
    >
    </.link>

    <div class="app-panel relative z-10 w-full max-w-2xl rounded-3xl p-6 shadow-2xl">
      <div class="mb-5 flex items-center justify-between gap-4">
        <div class="space-y-1">
          <p class="text-xs font-medium uppercase tracking-[0.16em] app-muted">
            Deck
          </p>
          <h2 class="text-xl font-semibold">{@page_title}</h2>
        </div>

        <.link
          patch={~p"/decks/#{@deck}"}
          class="rounded-full p-2 text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900"
          aria-label="Close modal"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </.link>
      </div>

      <.live_component
        module={FormComponent}
        id={@deck.id}
        title={@page_title}
        action={@live_action}
        deck={@deck}
        current_scope={@current_scope}
        patch={~p"/decks/#{@deck}"}
      />
    </div>
  </div>

  <div
    :if={@import_modal_open?}
    id="deck-import-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4"
  >
    <button
      type="button"
      phx-click="close_deck_importer"
      class="absolute inset-0 bg-zinc-950/60 backdrop-blur-sm"
      aria-label="Close import modal"
    >
    </button>

    <div class="app-panel relative z-10 w-full max-w-2xl rounded-3xl p-6 shadow-2xl">
      <div class="mb-5 flex items-start justify-between gap-4">
        <div class="space-y-1">
          <p class="text-xs font-medium uppercase tracking-[0.16em] app-muted">
            Decklist
          </p>
          <h2 class="text-xl font-semibold">Import Decklist</h2>
          <p class="text-sm app-muted">
            Paste one card per line. Quantity, set code, and collector number are optional, like "4 Lightning Bolt (M11) 149" or "Sol Ring".
          </p>
        </div>

        <button
          type="button"
          phx-click="close_deck_importer"
          class="rounded-full p-2 text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900"
          aria-label="Close import modal"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>

      <.form
        for={@import_form}
        id="deck-import-form"
        phx-submit="import_decklist"
        class="space-y-4"
      >
        <.input
          field={@import_form[:decklist]}
          type="textarea"
          id="deck-import-textarea"
          label="Cards"
          rows="10"
          placeholder="4 Lightning Bolt (M11) 149\nSol Ring\n2 Brainstorm\n1 Counterspell (MH2) 50"
          class="min-h-64 w-full resize-y rounded-xl border border-[var(--border)] bg-white px-4 py-3 text-sm leading-6 shadow-sm outline-none transition placeholder:text-zinc-400 focus:border-slate-900/40 focus:ring-4 focus:ring-slate-900/10"
        />

        <p class="text-sm app-muted">
          Blank lines are ignored. Imports append to the mainboard and existing matching entries are incremented.
        </p>

        <div
          :if={@import_errors != []}
          id="deck-import-errors"
          class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"
        >
          <p class="font-medium">Import needs attention</p>
          <ul class="mt-2 space-y-1">
            <li :for={error <- @import_errors}>
              line {error.line_number} ({error.card_text}): {error.message}
            </li>
          </ul>
        </div>

        <div class="flex justify-end gap-3">
          <button
            type="button"
            phx-click="close_deck_importer"
            class="app-button-secondary"
          >
            Cancel
          </button>

          <button type="submit" class="app-button">
            Import
          </button>
        </div>
      </.form>
    </div>
  </div>
</Layouts.app>
